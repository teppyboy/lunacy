<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd user agent.

  Install:
    cp contrib/dev.lunacy.plist ~/Library/LaunchAgents/
    # edit the paths below first
    launchctl load -w ~/Library/LaunchAgents/dev.lunacy.plist
    launchctl list | grep lunacy
    tail -f ~/Library/Logs/lunacy.log

  Unload:
    launchctl unload -w ~/Library/LaunchAgents/dev.lunacy.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.lunacy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/REPLACE/.cargo/bin/lunacy</string>
        <string>run</string>
        <string>-c</string>
        <string>/Users/REPLACE/.config/lunacy/config.toml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/REPLACE/workspace/lunacy</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/REPLACE/Library/Logs/lunacy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/REPLACE/Library/Logs/lunacy.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- launchd starts agents before the network; Lunacy retries polls anyway. -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
